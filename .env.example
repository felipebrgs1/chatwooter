# Chatwooter — variáveis de ambiente (dev via Docker).
# Copie para `.env` e ajuste:  cp .env.example .env
# O `docker-compose.yml` lê este arquivo com fallbacks sensatos, então a stack sobe mesmo sem `.env`.

# --- Banco (dev) ---
# O server também aceita DATABASE_URL; sem ela, monta a conexão com estes PG*.
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=chatwooter_dev

# --- Object storage S3-compatível (RustFS em dev) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123

# --- Segredos em repouso (server/) ---
# Chave AES-256 dos tokens de canal. Gere com: openssl rand -base64 32
# Em dev o docker-compose usa uma chave fixa de desenvolvimento se isto estiver vazio.
ENCRYPTION_KEY=
