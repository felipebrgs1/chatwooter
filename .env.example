# Chatwooter — variáveis de ambiente (dev via Docker).
# Copie para `.env` e ajuste:  cp .env.example .env
# O `docker-compose.yml` lê este arquivo (env_file) com fallbacks sensatos,
# então o app sobe mesmo sem `.env` — exceto o webhook do Telegram,
# que exige URL pública HTTPS (ver WEBHOOK_BASE_URL abaixo).

# --- Banco (dev) ---
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=chatwooter_dev
PGDATABASE_TEST=chatwooter_test

# --- Porta do app ---
PORT=4000

# --- Object storage S3-compatível (RustFS em dev) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=chatwooter-dev
AWS_REGION=us-east-1

# --- Webhooks dos providers (Telegram exige HTTPS pública) ---
# Local: exponha com ngrok/cloudflared e coloque a URL aqui, ex.:
# WEBHOOK_BASE_URL=https://abc123.ngrok-free.dev
# Vazio = app usa http://localhost:4000 e o Telegram recusa o setWebhook.
WEBHOOK_BASE_URL=

# --- Stack Go (server/) ---
# Chave AES-256 dos segredos em repouso (tokens de canal). Gere com: openssl rand -base64 32
# Em dev o docker-compose usa uma chave fixa de desenvolvimento se isto estiver vazio.
ENCRYPTION_KEY=
