# Dev image — toolchain only; code comes from bind mount, deps/build in volumes.
FROM elixir:1.20-slim

RUN apt-get update && \
    apt-get install -y ca-certificates openssl git build-essential inotify-tools && \
    rm -rf /var/lib/apt/lists/* && \
    mix local.hex --force && \
    mix local.rebar --force

WORKDIR /app
EXPOSE 4000
CMD ["bash", "docker/entrypoint-dev.sh"]
