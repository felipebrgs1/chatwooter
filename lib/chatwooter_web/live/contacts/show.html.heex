<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="flex h-screen overflow-hidden bg-n-surface-1 text-n-slate-12">
    <.sidebar current_scope={@current_scope} sidebar={@sidebar} />

    <div class="flex flex-col justify-between flex-1 h-full m-0 overflow-auto bg-n-surface-1">
      <section class="flex w-full h-full overflow-hidden justify-evenly bg-n-surface-1">
        <div class="flex flex-col w-full h-full transition-all duration-300 2xl:ml-56">
          <header class="sticky top-0 z-10 px-6 3xl:px-0">
            <div class="w-full mx-auto max-w-[40.625rem]">
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between w-full py-7 gap-2">
                <.breadcrumb
                  id="contact-breadcrumb"
                  items={[
                    %{label: "Contacts", navigate: ~p"/app/contacts"},
                    %{label: @contact.name}
                  ]}
                />
                <div class="flex items-center gap-2">
                  <.next_button
                    id="contact-block-toggle"
                    label={if(@contact.blocked, do: "Unblock contact", else: "Block contact")}
                    size={:sm}
                    color={:slate}
                    phx-click="toggle-block"
                  />
                  <.next_button
                    id="contact-send-message"
                    label="Send message"
                    size={:sm}
                    data-compose-trigger
                    phx-click={
                      JS.push("compose:toggle",
                        value: %{anchor: "contact-send-message", contact_id: @contact.id}
                      )
                    }
                  />
                </div>
              </div>
            </div>
          </header>
          <main class="flex-1 px-6 overflow-y-auto 3xl:px-px">
            <div class="w-full py-4 mx-auto max-w-[40.625rem]">
              <div class="flex flex-col items-start gap-8 pb-6">
                <.contact_profile
                  contact={@contact}
                  contact_labels={@contact_labels}
                  account_labels={@account_labels}
                />
                <.contact_form
                  form={@form}
                  form_params={@form_params}
                  country_options={@country_options}
                  companies={@companies}
                />
                <div class="flex flex-col items-start w-full gap-4 pt-6 border-t border-n-strong">
                  <div class="flex flex-col gap-2">
                    <h6 class="text-base font-medium text-n-slate-12">Delete contact</h6>
                    <span class="text-sm text-n-slate-11">
                      Permanently delete this contact. This action is irreversible
                    </span>
                  </div>
                  <.next_button
                    label="Delete contact"
                    color={:ruby}
                    phx-click={JS.dispatch("dialog:open", to: "#delete-contact-dialog")}
                  />
                </div>
                <.next_dialog
                  id="delete-contact-dialog"
                  type={:alert}
                  title="Confirm Deletion"
                  description="Are you sure you want to delete this contact?"
                  confirm_label="Yes, Delete"
                  on_confirm="delete"
                />
              </div>
            </div>
          </main>
        </div>

        <%!-- ContactsDetailsLayout: coluna no desktop, painel sobreposto no mobile --%>
        <div
          id="contact-sidebar"
          class="hidden lg:flex flex-col min-w-52 w-full max-w-md border-l border-n-weak bg-n-solid-2 data-[open]:flex data-[open]:fixed data-[open]:inset-y-0 data-[open]:right-0 data-[open]:z-50 data-[open]:w-[85%] sm:data-[open]:w-1/2 data-[open]:shadow-lg lg:data-[open]:static lg:data-[open]:w-full lg:data-[open]:shadow-none"
        >
          <div class="shrink-0">
            <div class="px-6 pt-6 pb-3">
              <.tab_bar
                id="contact-tab"
                tabs={@tabs}
                active={@active_tab}
                event="set-tab"
                class="w-full [&>button]:flex-auto [&>button]:px-3! bg-n-alpha-black2"
              />
            </div>
          </div>
          <div class="flex-1 min-h-0 overflow-y-auto pb-6 pt-3">
            <.contact_attributes
              :if={@active_tab == "attributes"}
              contact={@contact}
              attribute_definitions={@attribute_definitions}
            />
            <.contact_history
              :if={@active_tab == "history"}
              contact={@contact}
              conversations={@conversations}
            />
            <.contact_notes
              :if={@active_tab == "notes"}
              notes={@notes}
              current_scope={@current_scope}
            />
            <.contact_media :if={@active_tab == "media"} attachments={@attachments} />
            <.contact_merge
              :if={@active_tab == "merge"}
              contact={@contact}
              merge_candidates={@merge_candidates}
              merge_primary_id={@merge_primary_id}
              merge_error={@merge_error}
            />
          </div>
        </div>
        <div class="lg:hidden fixed right-6 top-28 sm:top-24 z-[60] flex p-1 bg-n-solid-2 border border-n-weak rounded-full">
          <.next_button
            variant={:ghost}
            color={:slate}
            size={:sm}
            icon="ph-sidebar-simple"
            class="rounded-full!"
            aria-label="Toggle contact sidebar"
            phx-click={JS.toggle_attribute({"data-open", ""}, to: "#contact-sidebar")}
          />
        </div>
      </section>
    </div>
  </div>
  <%!-- Fora do header (sticky z-10): no Chatwoot o popover vai para o body via Teleport --%>
  <.compose_conversation
    :if={@sidebar.compose.anchor == "contact-send-message"}
    compose={@sidebar.compose}
    user={@current_scope.user}
  />
</Layouts.app>
